.venv/
.venv-win/
__pycache__/
*.pyc
.ruff_cache/

# Per-job working data and the shared IT8 reference library are user data,
# not project source -- keep the directories tracked, not their contents.
/jobs/*
!/jobs/.gitkeep
/shared/it8_references/*
!/shared/it8_references/.gitkeep

# Local test data and outputs dropped in the project root (charts, profiles,
# instrument exports, installers) -- not project source.
/*.xlsx
/*.pdf
/*.icc
/*.icm
/*.csv
/*.txt
!/requirements*.txt
/*.xml
/*.jpg
/*.jpeg
/*.png
/*.tif
/*.tiff
/*.zip

# Windows bundle build output
/build/
/dist/
